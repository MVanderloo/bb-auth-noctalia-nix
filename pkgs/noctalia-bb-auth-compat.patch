+-- Luau's os.clock is a high-resolution elapsed-time clock. Newer v5
+-- builds no longer export noctalia.nowMs.
+local function nowMs()
+    if type(noctalia.nowMs) == "function" then
+        return noctalia.nowMs()
+    end
+    return os.clock() * 1000
+end
