+-- Noctalia's runAsync takes a shell command, not an argv table. Quote every
+-- argument: even a runtime directory can contain shell metacharacters.
+local function runAsync(argv)
+    local quoted = {}
+    for _, argument in ipairs(argv) do
+        table.insert(quoted, "'" .. string.gsub(argument, "'", "'\\''") .. "'")
+    end
+    return noctalia.runAsync(table.concat(quoted, " "))
+end
